# Copia este archivo como .env y ajusta lo que necesites.

# --- Proveedor de modelos: ollama (local, gratis) | openai | azure ---
PROVEEDOR=ollama
MODELO_CHAT=qwen3:8b
MODELO_EMBEDDINGS=qwen3-embedding:0.6b

# OpenAI:  PROVEEDOR=openai  MODELO_CHAT=gpt-4o-mini  MODELO_EMBEDDINGS=text-embedding-3-small
# OPENAI_API_KEY=

# Azure OpenAI: MODELO_CHAT y MODELO_EMBEDDINGS son los nombres de tus despliegues.
# AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Almacén de vectores: pgvector | memoria ---
ALMACEN=pgvector
DATABASE_URL=postgresql+psycopg://finrag:finrag@localhost:5433/finrag

# --- Recuperación ---
K=4
UMBRAL=0.35
